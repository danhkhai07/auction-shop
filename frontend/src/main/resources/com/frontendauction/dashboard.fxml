<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #f0f4f8;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.frontendauction.controller.DashboardController">

    <left>
        <VBox prefWidth="250.0" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 1 0 0;">
            <padding>
                <Insets bottom="30.0" left="20.0" right="20.0" top="40.0" />
            </padding>

            <Label text="AUCTION DASHBOARD" textFill="#1e3a8a">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
                <VBox.margin>
                    <Insets bottom="40.0" />
                </VBox.margin>
            </Label>

            <VBox spacing="10.0">
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#goToProfile" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;" text="Profile">
                    <padding>
                        <Insets left="15.0" />
                    </padding>
                </Button>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#goToLiveAuction" prefHeight="45.0" style="-fx-background-color: #e0e7ff; -fx-text-fill: #2d5af0; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;" text="Live auction">
                    <padding>
                        <Insets left="15.0" />
                    </padding>
                </Button>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#goToProductManagement" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8;" text="Product">
                    <padding>
                        <Insets left="15.0" />
                    </padding>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
            <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#logout" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #475569; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 8; -fx-background-color: aliceblue;" text="Log out" textFill="RED">
                <padding>
                    <Insets left="15.0" />
                </padding>
            </Button>
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_CENTER" spacing="20.0">
            <padding>
                <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
            </padding>

            <VBox maxWidth="800.0" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 15, 0, 0, 4);" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="40.0" left="50.0" right="50.0" top="40.0" />
                </padding>

                <Label alignment="CENTER" maxWidth="Infinity" text="Dashboard" textFill="#1e3a8a">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                    <VBox.margin>
                        <Insets bottom="15.0" />
                    </VBox.margin>
                </Label>

                <Separator style="-fx-background-color: transparent;" />
                <Region prefHeight="1.0" style="-fx-background-color: #e2e8f0;">
                    <VBox.margin>
                        <Insets bottom="30.0" top="10.0" />
                    </VBox.margin>
                </Region>

                <VBox spacing="15.0">

                    <HBox alignment="CENTER_LEFT" onMouseClicked="#goToProfile" pickOnBounds="true" prefHeight="60.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #f1f5f9; -fx-border-radius: 8; -fx-border-width: 1; -fx-cursor: hand;">
                        <padding>
                            <Insets left="20.0" right="20.0" />
                        </padding>
                        <Label text="Profile" textFill="#334155">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text=">" textFill="#94a3b8">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" onMouseClicked="#goToLiveAuction" pickOnBounds="true" prefHeight="60.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #f1f5f9; -fx-border-radius: 8; -fx-border-width: 1; -fx-cursor: hand;">
                        <padding>
                            <Insets left="20.0" right="20.0" />
                        </padding>
                        <Label text="Live auction" textFill="#334155">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text=">" textFill="#94a3b8">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" onMouseClicked="#goToProductManagement" pickOnBounds="true" prefHeight="60.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-border-color: #f1f5f9; -fx-border-radius: 8; -fx-border-width: 1; -fx-cursor: hand;">
                        <padding>
                            <Insets left="20.0" right="20.0" />
                        </padding>
                        <Label text="Product" textFill="#334155">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text=">" textFill="#94a3b8">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                    </HBox>

                </VBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>
