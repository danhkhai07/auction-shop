<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="720.0" prefWidth="1280.0" stylesheets="@css/global.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.frontendauction.controller.DashboardController">
    <children>
        <fx:include source="title-bar.fxml" />
        <StackPane VBox.vgrow="ALWAYS">
            <!-- Main content layer -->
            <VBox style="-fx-background-color: #f7f7f7;">

                <!-- Top navigation bar -->
                <HBox alignment="CENTER_LEFT" prefHeight="52.0" spacing="16.0" style="-fx-background-color: #ffffff; -fx-border-color: #e5e5e5; -fx-border-width: 0 0 1 0; -fx-padding: 0 28;">
                    <children>
                        <Button fx:id="btnHamburger" mnemonicParsing="false" onAction="#toggleMenu" styleClass="hamburger-btn" text="☰" />
                        <Label text="Auction Feed" textFill="#191919">
                            <font>
                                <Font name="System Bold" size="17.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <!-- Dashboard content -->
                <VBox spacing="20.0" style="-fx-padding: 28 36;" VBox.vgrow="ALWAYS">
                    <children>

                        <!-- Welcome hero card -->
                        <VBox spacing="8.0" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-padding: 28 32; -fx-border-color: #e5e5e5; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <Label text="🏠" style="-fx-font-size: 20px;" />
                                        <Label text="HOME" textFill="#191919">
                                            <font>
                                                <Font name="System Bold" size="22.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                                <Label fx:id="lblWelcome" text="Loading user..." textFill="#191919">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <Label fx:id="lblSummary" text="Loading dashboard data..." textFill="#707070" wrapText="true">
                                    <font>
                                        <Font size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <!-- Auctions section header -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="🔴" style="-fx-font-size: 14px;" />
                                <Label text="Live Auctions" textFill="#191919">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                            </children>
                            <padding>
                                <Insets top="4.0" bottom="4.0" />
                            </padding>
                        </HBox>

                        <!-- Auction list -->
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="auctionListContainer" spacing="14.0" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </VBox>

            <!-- Overlay layer (menu) — initially hidden -->
            <AnchorPane fx:id="menuOverlay" onMouseClicked="#closeMenu" styleClass="menu-overlay" visible="false">
                <!-- Side menu panel -->
                <VBox fx:id="sideMenu" prefWidth="280.0" styleClass="side-menu" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
                    <padding>
                        <Insets bottom="24.0" left="24.0" right="24.0" top="28.0" />
                    </padding>
                    <children>
                        <!-- Menu header -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="🏪" style="-fx-font-size: 18px;" />
                                <Label text="AUCTION SHOP" textFill="#191919">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                            </children>
                            <VBox.margin>
                                <Insets bottom="20.0" />
                            </VBox.margin>
                        </HBox>

                        <VBox spacing="6.0">
                            <children>
                                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToProfile" prefHeight="44.0" styleClass="menu-item" text="👤  Profile">
                                    <padding>
                                        <Insets left="16.0" />
                                    </padding>
                                </Button>
                                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToLiveAuction" prefHeight="44.0" styleClass="menu-item-active" text="🔴  Live Auctions">
                                    <padding>
                                        <Insets left="16.0" />
                                    </padding>
                                </Button>
                                <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToProductManagement" prefHeight="44.0" styleClass="menu-item" text="📦  Products">
                                    <padding>
                                        <Insets left="16.0" />
                                    </padding>
                                </Button>
                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS" />

                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#logout" prefHeight="44.0" styleClass="menu-item-logout" text="🚪  Log out">
                            <padding>
                                <Insets left="16.0" />
                            </padding>
                        </Button>
                    </children>
                </VBox>
            </AnchorPane>
        </StackPane>
    </children>
</VBox>
