<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefHeight="720.0" prefWidth="1280.0" styleClass="premium-background" stylesheets="@css/global.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.frontendauction.controller.ProductManagementController">
    <children>
        <fx:include source="title-bar.fxml" />
        <AnchorPane VBox.vgrow="ALWAYS">
            <children>
                <SplitPane dividerPositions="0.55" styleClass="split-pane-custom" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <items>

                <AnchorPane minHeight="0.0" minWidth="0.0">
                    <children>
                        <VBox styleClass="premium-card" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="0.0">
                            <padding>
                                <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                            </padding>
                            <children>

                                <HBox alignment="CENTER_LEFT">
                                    <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                                    <children>
                                        <Button fx:id="btnBack" mnemonicParsing="false" onAction="#handleBackToDashboard" styleClass="btn-text-only" text="&lt; Back to Dashboard" />
                                    </children>
                                </HBox>

                                <HBox alignment="CENTER" spacing="5.0" styleClass="section-header-box">
                                    <children>
                                        <Label style="-fx-letter-spacing: 1px;" text="YOUR PRODUCTS" textFill="#3d52b0">
                                            <font><Font name="System Bold" size="16.0" /></font>
                                        </Label>
                                    </children>
                                    <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                                </HBox>

                                <Separator styleClass="separator-custom">
                                    <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                                </Separator>

                                <TableView fx:id="tvProducts" styleClass="table-view-custom" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="60.0" style="-fx-alignment: CENTER;" text="ID" />
                                        <TableColumn fx:id="colName" prefWidth="220.0" text="Product name" />
                                        <TableColumn fx:id="colPrice" prefWidth="140.0" style="-fx-alignment: CENTER-RIGHT;" text="Started Price" />
                                        <TableColumn fx:id="colDescription" prefWidth="200.0" text="Description" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                            </children>
                        </VBox>
                    </children>
                </AnchorPane>

                <AnchorPane minHeight="0.0" minWidth="0.0">
                    <children>
                        <VBox alignment="TOP_CENTER" spacing="15.0" styleClass="premium-card" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                            <padding>
                                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                            </padding>
                            <children>

                                <HBox alignment="CENTER" spacing="5.0" styleClass="section-header-box">
                                    <children>
                                        <Label style="-fx-letter-spacing: 1px;" text="CHI TIẾT SẢN PHẨM" textFill="#3d52b0">
                                            <font><Font name="System Bold" size="16.0" /></font>
                                        </Label>
                                    </children>
                                </HBox>

                                <Separator styleClass="separator-custom" />

                                <GridPane hgap="15.0" vgap="15.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="130.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="250.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="100.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>

                                        <Label styleClass="form-label" text="ID" />
                                        <Label styleClass="form-label" text="Product Name" GridPane.rowIndex="1" />
                                        <Label styleClass="form-label" text="Started Price" GridPane.rowIndex="2" />
                                        <Label styleClass="form-label" text="Description" GridPane.rowIndex="3" GridPane.valignment="TOP">
                                            <GridPane.margin><Insets top="10.0" /></GridPane.margin>
                                        </Label>

                                        <TextField fx:id="txtId" disable="true" prefHeight="40.0" promptText="(Tạo tự động)" styleClass="input-field" GridPane.columnIndex="1" />
                                        <TextField fx:id="txtName" prefHeight="40.0" promptText="Nhập tên sản phẩm..." styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                        <TextField fx:id="txtPrice" prefHeight="40.0" promptText="Nhập giá khởi điểm..." styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                        <TextArea fx:id="txtDescription" prefHeight="100.0" promptText="Nhập thông tin chi tiết về tình trạng sản phẩm..." styleClass="input-area" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                    </children>
                                </GridPane>

                                <HBox alignment="CENTER" spacing="15.0">
                                    <VBox.margin><Insets top="10.0" /></VBox.margin>
                                    <children>
                                        <Button fx:id="btnAdd" mnemonicParsing="false" prefHeight="45.0" prefWidth="120.0" styleClass="btn-success" text="Add" />
                                        <Button fx:id="btnUpdate" mnemonicParsing="false" prefHeight="45.0" prefWidth="120.0" styleClass="btn-warning" text="Update" />
                                        <Button fx:id="btnDelete" mnemonicParsing="false" prefHeight="45.0" prefWidth="120.0" styleClass="btn-danger" text="Delete" />
                                    </children>
                                </HBox>

                                <Separator styleClass="separator-custom">
                                    <VBox.margin><Insets top="10.0" bottom="5.0" /></VBox.margin>
                                </Separator>

                                <HBox alignment="CENTER" spacing="5.0" styleClass="section-header-box">
                                    <children>
                                        <Label style="-fx-letter-spacing: 1px;" text="TẠO PHIÊN ĐẤU GIÁ" textFill="#3d52b0">
                                            <font><Font name="System Bold" size="14.0" /></font>
                                        </Label>
                                    </children>
                                </HBox>

                                <GridPane hgap="15.0" vgap="10.0">
                                    <columnConstraints>
                                        <ColumnConstraints hgrow="SOMETIMES" maxWidth="150.0" minWidth="10.0" prefWidth="130.0" />
                                        <ColumnConstraints hgrow="ALWAYS" minWidth="10.0" prefWidth="250.0" />
                                    </columnConstraints>
                                    <rowConstraints>
                                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                        <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
                                    </rowConstraints>
                                    <children>
                                        <Label styleClass="form-label" text="Starting Price" />
                                        <Label styleClass="form-label" text="Start Time" GridPane.rowIndex="1" />
                                        <Label styleClass="form-label" text="End Time" GridPane.rowIndex="2" />

                                        <TextField fx:id="txtAuctionPrice" prefHeight="40.0" promptText="VD: 100000" styleClass="input-field" GridPane.columnIndex="1" />
                                        <TextField fx:id="txtStartTime" prefHeight="40.0" promptText="yyyy-MM-ddTHH:mm:ss" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                                        <TextField fx:id="txtEndTime" prefHeight="40.0" promptText="yyyy-MM-ddTHH:mm:ss" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                                    </children>
                                </GridPane>

                                <HBox alignment="CENTER">
                                    <VBox.margin><Insets top="5.0" /></VBox.margin>
                                    <children>
                                        <Button fx:id="btnCreateAuction" mnemonicParsing="false" prefHeight="45.0" prefWidth="200.0" styleClass="btn-primary" text="Create Auction" />
                                    </children>
                                </HBox>

                            </children>
                        </VBox>
                    </children>
                </AnchorPane>

            </items>
                </SplitPane>
            </children>
        </AnchorPane>
    </children>
</VBox>
