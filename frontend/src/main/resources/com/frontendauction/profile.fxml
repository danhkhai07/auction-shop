<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.frontendauction.controller.ProfileController">
    <children>
        <fx:include source="title-bar.fxml" />
        <BorderPane style="-fx-background-color: #f4f6f9;" VBox.vgrow="ALWAYS">
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="20.0" style="-fx-background-color: #ffffff; -fx-padding: 0 24; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
                    <children>
                        <Button mnemonicParsing="false" onAction="#goBack" style="-fx-background-color: transparent; -fx-text-fill: #1e3a8a; -fx-font-weight: bold; -fx-font-size: 14px; -fx-cursor: hand;" text="&lt; Dashboard" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Profile" textFill="#1e3a8a">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#logout" style="-fx-background-color: #e0e7ff; -fx-text-fill: #1e3a8a; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 8 16; -fx-cursor: hand;" text="Log out" />
                    </children>
                </HBox>
            </top>

            <left>
                <VBox prefWidth="300.0" spacing="16.0" style="-fx-background-color: #ffffff; -fx-padding: 24; -fx-border-color: #e2e8f0; -fx-border-width: 0 1 0 0;">
                    <children>
                        <Label text="Account" textFill="#1e3a8a">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Separator />
                        <Label fx:id="lblUsername" text="Loading..." textFill="#0f172a" wrapText="true">
                            <font>
                                <Font name="System Bold" size="22.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblUserId" text="User ID: -" textFill="#475569" wrapText="true" />
                        <Label fx:id="lblRoles" text="Roles: -" textFill="#475569" wrapText="true" />
                        <Separator />
                        <VBox spacing="8.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 16;">
                            <children>
                                <Label text="Owned items" textFill="#64748b" />
                                <Label fx:id="lblItemCount" text="0" textFill="#1e3a8a">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <VBox spacing="8.0" style="-fx-background-color: #f8fafc; -fx-background-radius: 8; -fx-padding: 16;">
                            <children>
                                <Label text="Owned auctions" textFill="#64748b" />
                                <Label fx:id="lblAuctionCount" text="0" textFill="#1e3a8a">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <Region VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
            </left>

            <center>
                <VBox spacing="20.0" style="-fx-padding: 24;">
                    <children>
                        <VBox spacing="12.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Owned Items" textFill="#1e3a8a">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <TableView fx:id="tvOwnedItems" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colOwnedItemId" prefWidth="140.0" text="Item ID" />
                                        <TableColumn fx:id="colOwnedItemName" prefWidth="240.0" text="Name" />
                                        <TableColumn fx:id="colOwnedItemDescription" prefWidth="420.0" text="Description" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>

                        <VBox spacing="12.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-padding: 20; -fx-border-color: #e2e8f0; -fx-border-radius: 8;" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Owned Auctions" textFill="#1e3a8a">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>
                                <TableView fx:id="tvOwnedAuctions" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colOwnedAuctionId" prefWidth="140.0" text="Auction ID" />
                                        <TableColumn fx:id="colOwnedAuctionName" prefWidth="240.0" text="Name" />
                                        <TableColumn fx:id="colOwnedAuctionPrice" prefWidth="180.0" text="Current Price" />
                                        <TableColumn fx:id="colOwnedAuctionStatus" prefWidth="160.0" text="Status" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </center>
        </BorderPane>
    </children>
</VBox>
