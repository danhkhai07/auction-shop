<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.control.ScrollPane?>
<VBox prefHeight="720.0" prefWidth="1280.0" stylesheets="@css/global.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.frontendauction.controller.ProfileController">
    <children>
        <fx:include source="title-bar.fxml" />
        <BorderPane style="-fx-background-color: #f7f7f7;" VBox.vgrow="ALWAYS">

            <!-- Top navigation bar -->
            <top>
                <HBox alignment="CENTER_LEFT" prefHeight="60.0" spacing="16.0" style="-fx-background-color: #4A72FF; -fx-padding: 0 28; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 2);">
                    <children>
                        <Button mnemonicParsing="false" onAction="#goBack" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="← Home" />
                        <Label text="  /  " textFill="#e0e7ff" />
                        <Label text="Profile" textFill="white">
                            <font>
                                <Font name="System Bold" size="18.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#logout" style="-fx-font-size: 13px; -fx-padding: 8 20;" styleClass="btn-danger" text="Log out" />
                    </children>
                </HBox>
            </top>

            <!-- Left sidebar — Account info -->
            <left>
                <VBox prefWidth="280.0" spacing="16.0" style="-fx-background-color: #ffffff; -fx-padding: 28; -fx-border-color: #e5e5e5; -fx-border-width: 0 1 0 0;">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label style="-fx-font-size: 20px;" text="👤" />
                                <Label text="Account" textFill="#191919">
                                    <font>
                                        <Font name="System Bold" size="17.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                        <Separator />
                        <Label fx:id="lblUsername" text="Loading..." textFill="#191919" wrapText="true">
                            <font>
                                <Font name="System Bold" size="20.0" />
                            </font>
                        </Label>
                        <Label fx:id="lblUserId" style="-fx-font-size: 12px;" text="User ID: -" textFill="#707070" wrapText="true" />
                        <Label fx:id="lblRoles" style="-fx-font-size: 12px;" text="Roles: -" textFill="#707070" wrapText="true" />
                        <Separator />

                        <!-- Stats cards -->
                        <VBox spacing="6.0" style="-fx-background-color: #f7f7f7; -fx-background-radius: 10; -fx-padding: 16; -fx-border-color: #e5e5e5; -fx-border-radius: 10;">
                            <children>
                                <Label style="-fx-font-size: 12px;" text="Owned Items" textFill="#707070" />
                                <Label fx:id="lblItemCount" text="0" textFill="#3665f3">
                                    <font>
                                        <Font name="System Bold" size="28.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <VBox spacing="6.0" style="-fx-background-color: #f7f7f7; -fx-background-radius: 10; -fx-padding: 16; -fx-border-color: #e5e5e5; -fx-border-radius: 10;">
                            <children>
                                <Label style="-fx-font-size: 12px;" text="Owned Auctions" textFill="#707070" />
                                <Label fx:id="lblAuctionCount" text="0" textFill="#3665f3">
                                    <font>
                                        <Font name="System Bold" size="28.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <VBox spacing="6.0" style="-fx-background-color: #f7f7f7; -fx-background-radius: 10; -fx-padding: 16; -fx-border-color: #e5e5e5; -fx-border-radius: 10;">
                            <children>
                                <Label style="-fx-font-size: 12px;" text="Wallet Balance" textFill="#707070" />
                                <Label fx:id="lblBalance" text="0" textFill="#27ae60" wrapText="true">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                                <Button mnemonicParsing="false" onAction="#handleDeposit" prefHeight="35.0" prefWidth="240.0" style="-fx-margin-top: 10px;" styleClass="btn-primary" text="Deposit" />
                                <Button mnemonicParsing="false" onAction="#handleWithdraw" prefHeight="35.0" prefWidth="240.0" style="-fx-margin-top: 10px;" styleClass="btn-danger" text="Withdraw" />
                            </children>
                        </VBox>
                        <VBox spacing="6.0" style="-fx-background-color: #f7f7f7; -fx-background-radius: 10; -fx-padding: 16; -fx-border-color: #e5e5e5; -fx-border-radius: 10;">
                            <children>
                                <Label style="-fx-font-size: 12px;" text="Reputation" textFill="#707070" />
                                <Label fx:id="lblAverageStars" text="- ★" textFill="#eab308">
                                    <font>
                                        <Font name="System Bold" size="28.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                        <Region VBox.vgrow="ALWAYS" />
                    </children>
                </VBox>
            </left>

            <!-- Center — Owned Items + Owned Auctions Tables -->
            <center>
                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #f7f7f7; -fx-border-color: transparent;">
                    <content>
                        <VBox spacing="20.0" style="-fx-padding: 24 28;">
                            <children>
                        <!-- Owned Items Table -->
                        <VBox spacing="12.0" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #e5e5e5; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Owned Items" textFill="#191919">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Separator />
                                <TableView fx:id="tvOwnedItems" styleClass="table-view-custom" prefHeight="250.0">
                                    <columns>
                                        <TableColumn fx:id="colOwnedItemId" prefWidth="140.0" text="Item ID" />
                                        <TableColumn fx:id="colOwnedItemName" prefWidth="240.0" text="Name" />
                                        <TableColumn fx:id="colOwnedItemDescription" prefWidth="420.0" text="Description" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>

                        <!-- Owned Auctions Table -->
                        <VBox spacing="12.0" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #e5e5e5; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Owned Auctions" textFill="#191919">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Separator />
                                <TableView fx:id="tvOwnedAuctions" styleClass="table-view-custom" prefHeight="250.0">
                                    <columns>
                                        <TableColumn fx:id="colOwnedAuctionId" prefWidth="140.0" text="Auction ID" />
                                        <TableColumn fx:id="colOwnedAuctionName" prefWidth="240.0" text="Name" />
                                        <TableColumn fx:id="colOwnedAuctionPrice" prefWidth="180.0" text="Current Price" />
                                        <TableColumn fx:id="colOwnedAuctionStatus" prefWidth="140.0" text="Status" />
                                        <TableColumn fx:id="colOwnedAuctionAction" prefWidth="100.0" text="Action" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>

                        <!-- Reviews Table -->
                        <VBox spacing="12.0" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-padding: 20; -fx-border-color: #e5e5e5; -fx-border-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 8, 0, 0, 2);" VBox.vgrow="ALWAYS">
                            <children>
                                <Label text="Reviews" textFill="#191919">
                                    <font>
                                        <Font name="System Bold" size="16.0" />
                                    </font>
                                </Label>
                                <Separator />
                                <TableView fx:id="tvReviews" styleClass="table-view-custom" prefHeight="350.0">
                                    <columns>
                                        <TableColumn fx:id="colReviewTime" prefWidth="150.0" text="Thời gian" />
                                        <TableColumn fx:id="colReviewer" prefWidth="120.0" text="Người đánh giá" />
                                        <TableColumn fx:id="colReviewTarget" prefWidth="120.0" text="Người nhận" />
                                        <TableColumn fx:id="colReviewStars" prefWidth="80.0" text="Sao" />
                                        <TableColumn fx:id="colReviewComment" prefWidth="350.0" text="Nhận xét" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>
    </children>
</VBox>
