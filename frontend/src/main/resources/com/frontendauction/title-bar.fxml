<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox fx:id="titleBarContainer" alignment="CENTER_RIGHT" prefHeight="40.0" prefWidth="800.0" style="-fx-background-color: #2b303c; -fx-padding: 0 10 0 10;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.controller.CustomTitleBarController">
    <children>
        <Label style="-fx-text-fill: white; -fx-font-weight: bold;" text="Auction Shop" />

        <Region HBox.hgrow="ALWAYS" />

        <HBox alignment="CENTER" spacing="5.0">
            <children>
                <Button mnemonicParsing="false" onAction="#handleMinimize" prefHeight="30.0" prefWidth="30.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14;" text="-" />
                <Button mnemonicParsing="false" onAction="#handleFullScreen" prefHeight="26.0" prefWidth="38.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 12;" text="⛶" />
                <Button mnemonicParsing="false" onAction="#handleClose" prefHeight="30.0" prefWidth="30.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 14;" text="X" />
            </children>
        </HBox>
    </children>
</HBox>
